# Maintainer: Arthur Vinicius Willers <https://github.com/ArthurWillers>
pkgname=sift
pkgver=0.1.0
pkgrel=1
pkgdesc='Fast keyboard-and-swipe photo and video triage for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/ArthurWillers/sift'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::https://github.com/ArthurWillers/sift/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/sift "$pkgdir/usr/bin/sift"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/sift.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/sift.svg"
  install -Dm644 pkgbuild/sift.desktop "$pkgdir/usr/share/applications/sift.desktop"
}
