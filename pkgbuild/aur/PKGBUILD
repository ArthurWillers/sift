# Maintainer: Arthur Vinicius Willers <https://github.com/ArthurWillers>
pkgname=sift-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Fast keyboard-and-swipe photo and video triage for Omarchy (prebuilt binary)'
arch=('x86_64')
url='https://github.com/ArthurWillers/sift'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'xdg-desktop-portal')
provides=('sift')
conflicts=('sift')
source=("$pkgname-$pkgver.tar.gz::https://github.com/ArthurWillers/sift/releases/download/v$pkgver/sift-$pkgver-linux-x86_64.tar.gz")
sha256sums=('21045fdd3ecd2274a9ff24beced1397e00e6b73c7b49498ef621a99e70118127')

package() {
  cd "sift-$pkgver-linux-x86_64"
  install -Dm755 sift "$pkgdir/usr/bin/sift"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 sift.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/sift.svg"
  install -Dm644 sift.desktop "$pkgdir/usr/share/applications/sift.desktop"
}
